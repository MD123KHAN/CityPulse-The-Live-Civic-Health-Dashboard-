# CityPulse — .env template
# Copy this to .env and fill in API keys as needed.
# The system runs WITHOUT any API key using deterministic fallback summaries.

# Optional LLM integrations (pick one):
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=AIza...
# GEMINI_API_KEY=AIza...

# Database — SQLite file path (default: citypulse.db next to main.py)
# DB_PATH=./citypulse.db

# Server settings
HOST=0.0.0.0
PORT=8000
